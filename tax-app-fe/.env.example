# Inlined at build time: set before `next build`. Set to true only for the
# demonstration deployment or a local demo run; the backend must also set
# DEMO_LOGIN_ENABLED=true. Leave false everywhere else so the sign_in_demo
# WebMCP tool never appears on /login.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
# Agent navigation mode: "soft" (client-side routing, default) or "hard"
# (full page load). Switch to hard only if the native client does not refresh
# its tool list on client-side navigation.
NEXT_PUBLIC_WEBMCP_NAVIGATION=soft

# Server-side only (not inlined into the browser bundle). Proxy target for
# /api/be/* requests to the NestJS backend.
BACKEND_URL=http://localhost:3001
